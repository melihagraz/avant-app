{
  "expo": {
    "name": "Avant",
    "slug": "avant",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "avant",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avant.dating",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08080f"
      },
      "package": "com.avant.dating",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Avant profilinize fotograf eklemek icin foto galeri erisimi gereklidir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Avant yakininizdaki kisileri bulmak icin konumunuzu kullanir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8B86D"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://ertyxalazqtmdowjdzsq.supabase.co",
      "supabaseAnonKey": "sb_publishable_MYoZp-UGpXA8s4JzutonGQ_YUOr2-FB",
      "eas": {
        "projectId": "8e815905-5d90-4b90-9ce0-146abe07b807"
      }
    },
    "owner": "melihagraz3"
  }
}
