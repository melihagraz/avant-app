{
  "expo": {
    "name": "avant",
    "scheme": "avant",
    "slug": "avant",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avant.dating",
      "buildNumber": "3",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Avant uses your photo library to let you select profile photos that other users will see on your dating profile. For example, you can choose up to 6 photos from your gallery to showcase yourself.",
        "NSCameraUsageDescription": "Avant uses the camera to let you take a new photo for your dating profile. For example, you can snap a selfie to use as your main profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.avant.dating",
      "versionCode": 3,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D85A30"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Avant uses your photo library to let you select profile photos that other users will see on your dating profile. For example, you can choose up to 6 photos from your gallery to showcase yourself."
        }
      ],
      "@sentry/react-native/expo",
      "@sentry/react-native",
      "expo-font"
    ],
    "owner": "melihagraz4",
    "extra": {
      "supabaseUrl": "https://ertyxalazqtmdowjdzsq.supabase.co",
      "supabaseAnonKey": "sb_publishable_MYoZp-UGpXA8s4JzutonGQ_YUOr2-FB",
      "sentryDsn": "",
      "eas": {
        "projectId": "997d2e6d-f39d-4138-bbb6-031a8b72af54"
      }
    }
  }
}
